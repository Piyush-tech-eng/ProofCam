# Copy to .env for local configuration. The API loads this file from the project root.
NODE_ENV=development
PORT=3000
WEB_PORT=5173

# Default local proof-of-concept mode. It does not write to Solana.
PROOFCAM_REGISTRY_MODE=local_demo
PROOFCAM_DATA_DIR=../../.proofcam-data

# Enable after building/deploying the Anchor program and using a wallet transaction.
# Change PROOFCAM_REGISTRY_MODE to solana_devnet.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PROOFCAM_PROGRAM_ID=Fg6PaFpoGXkYsidMpWxqSWYBb7C5aMFgAq2j3vka1E8

# Optional local IPFS/Kubo HTTP API. Required for live Solana registration.
MANIFEST_STORAGE_API_URL=
MANIFEST_STORAGE_TOKEN=
MANIFEST_GATEWAY_URL=https://ipfs.io/ipfs

# Reserved for a future attestation validator and optional detector.
ATTESTATION_TRUST_ROOTS_PATH=
DEVICE_ATTESTATION_REQUIRED=false
DETECTOR_BASE_URL=http://localhost:8000

MAX_UPLOAD_BYTES=10485760
