{
  "name": "proofcam",
  "version": "0.1.0",
  "private": true,
  "description": "ProofCam — media-integrity system anchored on Solana",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
