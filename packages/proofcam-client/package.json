{
  "name": "@proofcam/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProofCam shared types, hashing, canonicalization, and verification SDK",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
